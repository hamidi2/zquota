#!/usr/bin/env python3
"""zquota — Unofficial CLI: view and spend your z.ai GLM Coding Plan gift quota-reset tokens.

Reuses the tokens ZCode stores on this machine; read-only, plus spending resets that already belong to the account.
Tokens never leave this machine (stored in ~/.config/zquota/accounts.json, mode 0600).
"""
import base64
import hashlib
import json
import os
import sys
import time
import urllib.request
import urllib.error
import uuid
from pathlib import Path

CREDS = Path.home() / ".zcode" / "v2" / "credentials.json"
STORE = Path.home() / ".config" / "zquota" / "accounts.json"
BASE_RESET = "https://zcode.z.ai/api/v1/coding-plan/reset"
BASE_QUOTA = "https://api.z.ai/api/monitor/usage/quota/limit"
# server expects uppercase reset types (verified: lowercase => "3001 parameter error")
SERVER_RESET_TYPE = {"week": "WEEK", "five_hour": "FIVE_HOUR"}

# ---------- crypto (same scheme as ZCode: enc:v1 = iv.tag.ct, AES-256-GCM) ----------

def _secret():
    s = os.environ.get("ZCODE_CREDENTIAL_SECRET")
    if s:
        return s
    try:
        import pwd
        user = pwd.getpwuid(os.getuid()).pw_name
    except Exception:
        user = "unknown"
    # must match node's os.platform() spelling ('linux', not 'Linux')
    return f"zcode-credential-fallback:{sys.platform}:{Path.home()}:{user}"

def _key():
    return hashlib.sha256(_secret().encode()).digest()

def _b64(p):
    return base64.urlsafe_b64decode(p + "=" * (-len(p) % 4))

def decrypt(v):
    if not v.startswith("enc:v1:"):
        return v
    a, c, u = v[6:].split(".")
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    return AESGCM(_key()).decrypt(_b64(a), _b64(u) + _b64(c), None).decode()

# ---------- accounts ----------

def load_active():
    """Account(s) currently logged in via ZCode."""
    if not CREDS.exists():
        return []
    d = json.loads(CREDS.read_text())
    out = []
    try:
        ui = json.loads(decrypt(d["oauth:zai:user_info"]))
        tok = decrypt(d["zcodejwttoken"])
        zai = decrypt(d["oauth:zai:access_token"])
        out.append({
            "id": ui.get("user_id", "unknown"),
            "name": ui.get("name") or ui.get("email", "unknown"),
            "email": ui.get("email", ""),
            "zcode_jwt": tok,
            "zai_token": zai,
        })
    except Exception as e:
        print(f"! failed to read active account: {e}", file=sys.stderr)
    return out

def load_saved():
    if STORE.exists():
        os.chmod(STORE, 0o600)
        return json.loads(STORE.read_text())
    return {}

def save_accounts(accounts):
    STORE.parent.mkdir(parents=True, exist_ok=True)
    STORE.write_text(json.dumps(accounts, indent=1, ensure_ascii=False))
    os.chmod(STORE, 0o600)

def all_accounts():
    """saved + active accounts (the active one wins, with fresh tokens)."""
    saved = load_saved()
    for a in load_active():
        saved[a["id"]] = a
    return list(saved.values())

# ---------- API ----------

def api(url, acc, method="GET", body=None):
    if "/monitor/usage/quota/limit" in url:
        # this endpoint only accepts the raw z.ai token, without the Bearer prefix
        h = {"authorization": acc["zai_token"]}
    else:
        h = {
            "Authorization": f"Bearer {acc['zcode_jwt']}",
            "X-Bigmodel-Authorization": acc["zai_token"],
            "Bigmodel-Target-Type": "PERSONAL",
        }
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        h["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=h, method=method)
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read())

def reset_status(acc):
    d = api(f"{BASE_RESET}/status", acc)["data"]
    return {
        "five_hour": [x["expire_at"] for x in d["available_five_hour_resets"]],
        "week": [x["expire_at"] for x in d["available_week_resets"]],
        "last_five_hour_used": (d.get("latest_five_hour_reset_history") or {}).get("used_at"),
        "last_week_used": (d.get("latest_week_reset_history") or {}).get("used_at"),
    }

def quota(acc):
    d = api(BASE_QUOTA, acc)
    if d.get("code") != 200:
        return None
    lim = {x["unit"]: x for x in d["data"]["limits"]}  # unit 3=5h, 6=weekly
    return lim

def fmt_ts(ms):
    """Format a server timestamp (ms) as a human duration relative to now."""
    if not ms:
        return "unknown"
    dt = ms / 1000 - time.time()
    past = dt < 0
    dt = abs(dt)
    m, h = int(dt // 60) % 60, int(dt // 3600)
    out = f"{h}h {m:02d}m" if h else f"{m}m"
    return out + (" ago" if past else "")

# ---------- commands ----------

def cmd_accounts():
    for a in all_accounts():
        act = load_active()
        tag = " (active in ZCode)" if act and a["id"] == act[0]["id"] else ""
        print(f"  {a['id'][:8]}  {a['name']}  <{a['email']}>{tag}")
    if not all_accounts():
        print("No accounts found.")

def cmd_save():
    act = load_active()
    if not act:
        sys.exit("No active account found.")
    saved = load_saved()
    for a in act:
        saved[a["id"]] = a
        print(f"saved: {a['name']} <{a['email']}>")
    save_accounts(saved)

def show_status(a):
    try:
        s = reset_status(a)
    except urllib.error.HTTPError as e:
        print(f"  {a['name']}: HTTP error {e.code}")
        return
    print(f"▪ {a['name']} <{a['email']}>")
    try:
        q = quota(a)
    except Exception:
        q = None
    if q:
        for unit, label in ((3, "5-hour"), (6, "weekly")):
            if unit in q:
                x = q[unit]
                remaining = 100 - x["percentage"]  # server percentage = used
                print(f"   {label:7s}: {remaining:3d}% left, next natural reset in {fmt_ts(x.get('nextResetTime'))}")
    print(f"   Gift resets: weekly ×{len(s['week'])}", end="")
    if s["week"]:
        print(f"  (soonest expires in {fmt_ts(min(s['week']))})", end="")
    print(f" | 5-hour ×{len(s['five_hour'])}")
    for label, t in (("weekly", s["last_week_used"]), ("5-hour", s["last_five_hour_used"])):
        if t:
            print(f"   last spent ({label}): {fmt_ts(t)}")

def cmd_status():
    for a in all_accounts():
        show_status(a)

def cmd_reset(name=None, rtype=None, yes=False):
    accs = all_accounts()
    if not accs:
        sys.exit("No accounts found.")
    acc = accs[0]
    if name or len(accs) > 1:
        for i, a in enumerate(accs, 1):
            print(f" {i}) {a['name']} <{a['email']}>")
        idx = name or input("Account number: ")
        acc = accs[int(idx) - 1]
    s = reset_status(acc)
    avail = [("week", s["week"]), ("five_hour", s["five_hour"])]
    avail = [(t, v) for t, v in avail if v]
    if not avail:
        sys.exit(f"No available resets for {acc['name']} .")
    if not rtype:
        for i, (t, v) in enumerate(avail, 1):
            print(f" {i}) {t} ×{len(v)}")
        rtype = avail[int(input("Which reset? ")) - 1][0]
    if rtype not in ("week", "five_hour"):
        sys.exit("Invalid type (week | five_hour)")
    if not yes:
        r = input(f"Spend a {rtype} reset for {acc['name']}[y/N] ")
        if r.strip().lower() not in ("y", "yes"):
            sys.exit("Cancelled.")
    api(f"{BASE_RESET}/use", acc, method="POST",
        body={"idempotency_key": uuid.uuid4().hex, "reset_type": SERVER_RESET_TYPE[rtype]})
    print(f"✅ Reset {rtype} reset for {acc['name']} done.")
    show_status(acc)

def cmd_reset_now(acc, rtype):
    """Non-interactive spend (used by watch)."""
    api(f"{BASE_RESET}/use", acc, method="POST",
        body={"idempotency_key": uuid.uuid4().hex, "reset_type": SERVER_RESET_TYPE[rtype]})

def cmd_probe():
    """Diagnostics: clock skew vs server, account auth, reset-endpoint sanity.
    Safe: never spends anything (probes only run while no five_hour reset is available)."""
    from email.utils import parsedate_to_datetime
    for a in all_accounts():
        print(f"▪ {a['email']}")
        req = urllib.request.Request(f"{BASE_RESET}/status", headers={
            "Authorization": f"Bearer {a['zcode_jwt']}",
            "X-Bigmodel-Authorization": a["zai_token"],
            "Bigmodel-Target-Type": "PERSONAL"})
        t0 = time.time()
        with urllib.request.urlopen(req, timeout=20) as r:
            body = r.read()
        t1 = time.time()
        skew = parsedate_to_datetime(r.headers.get("Date")).timestamp() - (t0 + t1) / 2
        d = json.loads(body)["data"]
        n5, nw = len(d["available_five_hour_resets"]), len(d["available_week_resets"])
        print(f"   auth: OK | server clock skew: {skew:+.1f}s | available: 5h×{n5} week×{nw}")
        for k in ("latest_five_hour_reset_history", "latest_week_reset_history"):
            h = d.get(k)
            if h:
                print(f"   last {k[7:-8]} spend: {time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(h['used_at']/1000))}")
        ok, nxt = request_opportunity(a)
        if ok:
            print("   opportunity: GRANTED right now")
        else:
            when = time.strftime('%H:%M:%S', time.localtime(nxt/1000)) if nxt else "server gave no time"
            print(f"   opportunity: not allowed yet (next_try_at: {when})")
        if n5 == 0:
            # safe: type-validity probe with nothing to spend (expect non-3001 response)
            try:
                api(f"{BASE_RESET}/use", a, method="POST",
                    body={"idempotency_key": uuid.uuid4().hex, "reset_type": "FIVE_HOUR"})
                print("   probe: UNEXPECTED success (check!)")
            except urllib.error.HTTPError as e:
                body = e.read().decode(errors="replace")[:120]
                tag = "type accepted (server processing error on empty set)" if '"code":3001' not in body else "3001 PARAM ERROR - server rejects type! (update zquota)"
                print(f"   probe: HTTP {e.code} {body.strip()} -> {tag}")
            except Exception as e:
                print(f"   probe: {e}")
        else:
            print("   probe: skipped (five_hour reset available - not spending it)")

def request_opportunity(acc):
    """Ask the server for permission to spend a reset (same flow as the official client).
    Returns (granted, next_try_at_ms)."""
    body = json.dumps({"idempotency_key": uuid.uuid4().hex}).encode()
    req = urllib.request.Request(f"{BASE_RESET}/opportunity", data=body, method="POST",
        headers={"Authorization": f"Bearer {acc['zcode_jwt']}",
                 "X-Bigmodel-Authorization": acc["zai_token"],
                 "Bigmodel-Target-Type": "PERSONAL",
                 "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            d = json.loads(r.read())
            data = d.get("data") or {}
            return bool(data.get("granted")), data.get("next_try_at")
    except urllib.error.HTTPError as e:
        try:
            d = json.loads(e.read().decode(errors="replace"))
            data = d.get("data") or {}
            if d.get("code") == 3301:
                return False, data.get("next_try_at")
        except Exception:
            pass
        return False, None

def cmd_watch(threshold_min=5.0, interval_sec=30, dry_run=False):
    """Spend any reset with <=threshold minutes left before its expiry.
    Mirrors the official client: an opportunity (server permission) is requested first;
    if the server says "not yet" (code 3301) we retry exactly at next_try_at.
    grant state is kept per account id in-memory."""
    print(f"watch started (all accounts): resets with <= {threshold_min:g} min left before expiry "
          f"are spent automatically (opportunity-gated, retried until expiry). "
          f"Checking every {interval_sec}s." + (" [DRY-RUN]" if dry_run else ""), flush=True)
    grant = {}   # acc_id -> {"next_try_at": ms, "granted": bool}
    while True:
        try:
            for a in all_accounts():
                try:
                    st = reset_status(a)
                except Exception as e:
                    print(f"[{time.strftime('%H:%M:%S')}] ! {a['email']}: failed to read status: {e}", flush=True)
                    continue
                now = time.time() * 1000
                for rtype in ("week", "five_hour"):
                    exp = st[rtype]
                    if not exp:
                        continue
                    remain_min = (min(exp) - now) / 60000
                    if remain_min > threshold_min:
                        continue
                    g = grant.setdefault(a["id"], {"next_try_at": 0, "granted": False})
                    ts = time.strftime("%H:%M:%S")
                    if dry_run:
                        print(f"[{ts}] [DRY] {a['email']}: {rtype} reset would be spent ({remain_min:.1f} min left).", flush=True)
                        continue
                    if not g["granted"]:
                        if now < g["next_try_at"]:
                            continue  # server said "not yet"; wait exactly until next_try_at
                        ok, nxt = request_opportunity(a)
                        if ok:
                            g["granted"] = True
                            print(f"[{ts}] == {a['email']}: opportunity GRANTED for {rtype}.", flush=True)
                        else:
                            g["next_try_at"] = nxt or (now + 10 * 60000)
                            print(f"[{ts}] .. {a['email']}: opportunity not allowed yet "
                                  f"(retry at {time.strftime('%H:%M:%S', time.localtime((g['next_try_at'])/1000))}).", flush=True)
                            continue
                    try:
                        cmd_reset_now(a, rtype)
                        print(f"[{ts}] OK {rtype} reset spent for {a['email']} ({remain_min:.1f} min before expiry).", flush=True)
                        g["granted"] = False
                        g["next_try_at"] = 0
                    except urllib.error.HTTPError as e:
                        body = e.read().decode(errors="replace")[:300]
                        print(f"[{ts}] ! {a['email']}: spending {rtype} failed - HTTP {e.code}: {body} "
                              f"({remain_min:.1f} min to expiry; will retry)", flush=True)
                    except Exception as e:
                        print(f"[{ts}] ! {a['email']}: spending {rtype} failed: {e}", flush=True)
        except Exception as e:
            print(f"[{time.strftime('%H:%M:%S')}] ! error: {e}", flush=True)
        time.sleep(interval_sec)

def main():
    os.umask(0o077)
    args = sys.argv[1:]
    if not args or args[0] in ("status", "s"):
        cmd_status()
    elif args[0] == "accounts":
        cmd_accounts()
    elif args[0] == "watch":
        thr, itv, dry = 5.0, 30, False
        if "--min" in args:
            thr = float(args[args.index("--min") + 1])
        if "--interval" in args:
            itv = int(args[args.index("--interval") + 1])
        dry = "--dry-run" in args
        cmd_watch(thr, itv, dry)
    elif args[0] == "probe":
        cmd_probe()
    elif args[0] == "save":
        cmd_save()
    elif args[0] == "reset":
        name = args[1] if len(args) > 1 else None
        rtype = args[2] if len(args) > 2 else None
        yes = "-y" in args
        if yes:
            rest = [a for a in args[1:] if a != "-y"]
            name, rtype = (rest + [None, None])[:2]
        cmd_reset(name, rtype, yes)
    elif args[0] in ("-h", "--help", "help"):
        print(__doc__)
        print("""Commands:
  zquota status            quota + available gift resets for all accounts
  zquota accounts          list accounts
  zquota save              snapshot the current ZCode login into zquota
                           (multi-account: log in with each account in ZCode and
                           run zquota save; supports any number of accounts)
  zquota reset [n] [type] [-y]
                           spend a reset manually; type = week | five_hour
  zquota probe              diagnostics: clock skew, auth, reset-endpoint sanity (safe)
  zquota watch [--min 5] [--interval 30] [--dry-run]
                           daemon: only spends resets within --min minutes of expiry (errors logged in detail)""")
    else:
        sys.exit(f"unknown command: {args[0]}  — see help.")

if __name__ == "__main__":
    main()